# CivicAQI Environment Configuration
# Copy this file to .env and fill in your credentials.
# Supports Google Application Default Credentials (ADC) via Service Account JSON.

PORT=3000

# Google Cloud / ADC Service Account Configuration (Primary)

GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-3.6-flash

# Optional: Direct Gemini API Key (Fallback if not using ADC)
GEMINI_API_KEY=

# Firebase Authentication Configuration (Web API Key & 
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
